  - missionName: Velvet Room Raid
    description: Jacknife's crew holds the Velvet Room club. Yuki wants them gone.
    map:
      width: 14
      depth: 12
      seed: 707
      maxHeight: 2
      heightStep: 0.5
      edgeDepth: 2
      holeChance: 0.04
